{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    "schedule:weekly",
    ":automergeMinor",
    ":automergePatch",
    ":automergeDigest",
    ":prHourlyLimit2",
    ":prConcurrentLimit10"
  ],
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps):",
  "rangeStrategy": "bump",
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"]
  },
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": false,
    "minimumReleaseAge": "0 days",
    "schedule": "at any time"
  },
  "packageRules": [
    {
      "description": "Pin GitHub Actions and review workflow updates",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "pinDigests": true,
      "automerge": false
    },
    {
      "description": "Group all .NET / Microsoft / OpenTelemetry NuGet packages",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["/^Microsoft\\./", "/^OpenTelemetry\\./", "/^Azure\\./"],
      "groupName": "dotnet-msft-otel"
    },
    {
      "description": "Move the .NET SDK pin (global.json), the SDK and ASP.NET container image tags, and the dotnet-ef tool together, and raise the PR promptly. CI picks up new SDK patches on its own, so a stale pin breaks locked-mode restores (NU1004) until the lock files are regenerated; this must not wait for the weekly schedule. The MCR registry exposes no release timestamp to Renovate, so the release-age gate must treat a missing timestamp as optional or the image tags would never join the group.",
      "matchPackageNames": ["dotnet-sdk", "mcr.microsoft.com/dotnet/sdk", "mcr.microsoft.com/dotnet/aspnet", "dotnet-ef"],
      "groupName": "dotnet-toolchain",
      "schedule": ["at any time"],
      "minimumReleaseAge": "1 day",
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "automerge": false,
      "labels": ["dependencies", "dotnet-toolchain"],
      "prBodyNotes": [
        "Regenerate the NuGet lock files with the new SDK before merging (`dotnet restore --force-evaluate`), and move `global.json`, the Dockerfile tags and the lock files together."
      ]
    },
    {
      "description": "Group .NET test packages",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["xunit", "/^xunit\\./", "Moq", "/^Moq\\./", "FluentAssertions", "coverlet.collector", "Microsoft.NET.Test.Sdk"],
      "groupName": "dotnet-testing"
    },
    {
      "description": "Group Lynx packages",
      "matchManagers": ["npm"],
      "matchPackageNames": ["/^@lynx-js\\//"],
      "groupName": "lynx"
    },
    {
      "description": "Group Astro stack",
      "matchManagers": ["npm"],
      "matchPackageNames": ["astro", "/^@astrojs\\//", "tailwindcss", "/^@tailwindcss\\//"],
      "groupName": "astro-tailwind"
    },
    {
      "description": "Pin major bumps to require manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major"]
    }
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.git/**"
  ]
}
